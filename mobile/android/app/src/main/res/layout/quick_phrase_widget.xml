<?xml version="1.0" encoding="utf-8"?>
<!--
  Four large phrase buttons.

  Sizing and contrast follow the same rules as the in-app board: big targets,
  calm colours, nothing decorative competing with the words. A home-screen
  widget is visible to anyone holding the device, including over a lock
  screen, so it carries phrase labels only - never the child's name and never
  any history.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@drawable/quick_phrase_background">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/quick_phrase_title"
        android:textSize="12sp"
        android:textColor="#5A6B68"
        android:paddingBottom="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/phrase_0"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:gravity="center"
            android:padding="6dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#12221F"
            android:background="@drawable/quick_phrase_button" />

        <TextView
            android:id="@+id/phrase_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:gravity="center"
            android:padding="6dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#12221F"
            android:background="@drawable/quick_phrase_button" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/phrase_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:gravity="center"
            android:padding="6dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#12221F"
            android:background="@drawable/quick_phrase_button" />

        <TextView
            android:id="@+id/phrase_3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:gravity="center"
            android:padding="6dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#12221F"
            android:background="@drawable/quick_phrase_button" />
    </LinearLayout>
</LinearLayout>
