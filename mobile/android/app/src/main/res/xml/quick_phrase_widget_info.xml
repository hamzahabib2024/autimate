<?xml version="1.0" encoding="utf-8"?>
<!--
  Quick-phrase home-screen widget.

  Deliberately small: four buttons at most. A widget with more than that stops
  being faster than opening the app, which is the only reason it exists.

  NOT YET VERIFIED ON A DEVICE - this machine has no Android SDK. The Dart
  side is complete and tested; this native side is written but unrun.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/quick_phrase_widget"
    android:previewLayout="@layout/quick_phrase_widget"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
