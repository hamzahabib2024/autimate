# Dart/Flutter build artefacts outside mobile/ (mobile/ has its own .gitignore)
.dart_tool/
build/
.packages

# Coverage output
coverage/

# Firebase service-account keys. These are the genuine secret: unlike the
# client config files, a service account contains a private key and grants
# admin access that bypasses every security rule. One must never be
# committed, so the pattern is ignored rather than left to vigilance.
*serviceAccount*.json
*-adminsdk-*.json
firebase-adminsdk-*.json

# Local environment files. The tracked template is .env.example; a real one
# must never be committed.
.env
.env.local
*.env.local

# Documents.
#
# Every Markdown file is ignored except README.md, which stays as the entry
# point at any level (mobile/, tools/, assets/fonts/ all keep theirs).
# Office and PDF documents are ignored outright — they are large binaries
# that git cannot diff, and they belong in shared storage rather than here.
*.md
!README.md
!FIREBASE-SETUP.md

*.pdf
*.docx
*.doc
*.pptx
*.ppt
*.xlsx
*.xls
